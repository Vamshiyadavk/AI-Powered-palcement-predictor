# SQLite is the default for local development.
DATABASE_URL=sqlite:///placement.db
JWT_SECRET=replace-with-a-long-random-secret
PORT=8080

# Free Gemini API Key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# For MySQL, use:
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/placement_db